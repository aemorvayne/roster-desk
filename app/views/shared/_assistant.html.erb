<aside class="assistant-panel card p-4" aria-labelledby="assistant-heading">
  <p class="eyebrow mb-2">CHAT</p>
  <h2 class="h5 mb-2" id="assistant-heading">Assistant</h2>
  <p class="small text-secondary">Ask about users, or tell me who to filter or select.</p>
  <div class="chat-messages mb-4">
    <% if @report %>
      <div class="chat-question rounded p-3 mb-3"><span class="small fw-semibold">You</span><p class="mb-0"><%= @question %></p></div>
      <div class="chat-answer rounded p-3" role="status"><%= @report.text %></div>
    <% else %>
      <p class="small text-secondary mb-0">Try “How many users are blocked?”</p>
    <% end %>
  </div>
  <%= form_with url: chat_path, class: 'd-flex flex-column gap-2', data: { controller: 'chat' } do |form| %>
    <div>
      <%= form.label :question, 'Your question', class: 'visually-hidden' %>
      <%= form.text_area :question, rows: 3, maxlength: DirectoryAssistant::MAX_QUESTION_LENGTH, required: true, placeholder: 'Type a message…', class: 'form-control', data: { action: 'keydown->chat#send' } %>
    </div>
    <%= form.submit 'Send', class: 'btn btn-primary align-self-end' %>
  <% end %>
  <p class="small text-secondary mt-2 mb-0">Enter to send · Shift+Enter for a new line.</p>
  <p class="small text-secondary mt-2 mb-0">Questions are sent to OpenAI.</p>
</aside>
