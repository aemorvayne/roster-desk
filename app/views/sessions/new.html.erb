<section class="auth-panel card shadow-sm mx-auto p-4 p-md-5">
  <p class="eyebrow">WELCOME TO ROSTER DESK</p>
  <h1 class="h3">Good to see you.</h1>
  <p class="text-secondary mb-4">Sign in to manage your people.</p>
  <%= form_with url: session_path do |form| %>
    <div class="mb-3"><%= form.label :email, class: 'form-label' %><%= form.email_field :email, required: true, autocomplete: 'username', class: 'form-control' %></div>
    <div class="mb-4"><%= form.label :password, class: 'form-label' %><%= form.password_field :password, required: true, autocomplete: 'current-password', class: 'form-control' %></div>
    <%= form.submit 'Sign in', class: 'btn btn-primary w-100' %>
  <% end %>
  <p class="small text-center mt-4 mb-0">New here? <%= link_to 'Create an account', new_registration_path %></p>
</section>
